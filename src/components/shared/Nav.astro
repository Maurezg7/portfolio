---
const navItems = [
  { name: "INICIO", key: "nav.home", href: "/portfolio/" },
  { name: "SOBRE MI", key: "nav.about", href: "/portfolio/aboutme/" },
  { name: "HABILIDADES", key: "nav.skills", href: "/portfolio/skills/" },
  { name: "PROYECTOS", key: "nav.projects", href: "/portfolio/projects/" },
  { name: "CONTACTO", key: "nav.contact", href: "/portfolio/contact/" },
];
const rawPath = Astro.url.pathname;
const pathname = rawPath === "/portfolio/" ? "/portfolio/" : rawPath.replace(/\/$/, "");
---

<nav>
  <div class="despliegue">
    <button id="menu-toggle" type="button" aria-label="Menú" data-i18n-aria="nav.menu">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="currentColor"
        viewBox="0 0 16 16"
      >
        <path
          d="M4 4v2H2V4zm1 7V9a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m0-5V4a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m5 5V9a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1m0-5V4a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1M9 4v2H7V4zm5 0h-2v2h2zM4 9v2H2V9zm5 0v2H7V9zm5 0v2h-2V9zm-3-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1zm1 4a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V9a1 1 0 0 0-1-1z"
        ></path>
      </svg>
    </button>
    <ul id="menu-items" class="hidden">
      {
        navItems.map((item, i) => {
          const isActive = pathname === item.href; // Guardamos el estado

          return (
            <li>
              <div class:list={["cont_sections", { "is-active": isActive }]}>
                <span class="menu-number">
                  [{(i + 1).toString().padStart(2, "0")}]
                </span>

                <a href={item.href} class:list={[{ active: isActive }]}>
                  <span data-i18n={item.key}>{item.name}</span>
                </a>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  fill="currentColor"
                  class="bi bi-arrow-down-right"
                  viewBox="0 0 16 16"
                >
                  <path
                    fill-rule="evenodd"
                    d="M14 13.5a.5.5 0 0 1-.5.5h-6a.5.5 0 0 1 0-1h4.793L2.146 2.854a.5.5 0 1 1 .708-.708L13 12.293V7.5a.5.5 0 0 1 1 0z"
                  />
                </svg>
              </div>
            </li>
          );
        })
      }
      <li class="contact-me">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          fill="currentColor"
          class="bi bi-caret-right"
          viewBox="0 0 16 16"
        >
          <path
            d="M6 12.796V3.204L11.481 8zm.659.753 5.48-4.796a1 1 0 0 0 0-1.506L6.66 2.451C6.011 1.885 5 2.345 5 3.204v9.592a1 1 0 0 0 1.659.753"
          ></path>
        </svg>
        <a
          href="https://www.linkedin.com/in/maurezg7/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="social-link"
        >
          <span class="card-inner">
            <span class="card-face card-front">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="currentColor"
                class="bi bi-linkedin"
                viewBox="0 0 16 16"
              >
                <path
                  d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"
                ></path>
              </svg>
            </span>
            <span class="card-face card-back">
              <span class="social-name social-name--full">LinkedIn</span>
              <span class="social-name social-name--short" aria-hidden="true">In</span>
            </span>
          </span>
        </a>
        <a
          href="https://github.com/Maurezg7"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="social-link"
        >
          <span class="card-inner">
            <span class="card-face card-front">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="currentColor"
                class="bi bi-github"
                viewBox="0 0 16 16"
              >
                <path
                  d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"
                ></path>
              </svg>
            </span>
            <span class="card-face card-back">
              <span class="social-name social-name--full">GitHub</span>
              <span class="social-name social-name--short" aria-hidden="true">Git</span>
            </span>
          </span>
        </a>
        <a
          href="https://x.com/maurezg7"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="X (antes Twitter)"
          class="social-link"
        >
          <span class="card-inner">
            <span class="card-face card-front">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="currentColor"
                class="bi bi-twitter-x"
                viewBox="0 0 16 16"
              >
                <path
                  d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865z"
                ></path>
              </svg>
            </span>
            <span class="card-face card-back">
              <span class="social-name social-name--full">X</span>
              <span class="social-name social-name--short" aria-hidden="true">X</span>
            </span>
          </span>
        </a>
        <a
          href="https://www.instagram.com/isdeiko/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="social-link"
        >
          <span class="card-inner">
            <span class="card-face card-front">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="currentColor"
                class="bi bi-instagram"
                viewBox="0 0 16 16"
              >
                <path
                  d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599s.453.546.598.92c.11.281.24.705.275 1.485.039.844.046 1.097.046 3.231s-.007 2.387-.046 3.232c-.035.78-.166 1.203-.275 1.485a2.5 2.5 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.5 2.5 0 0 1-.92-.598 2.5 2.5 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.844-.046-1.097-.046-3.233s.008-2.388.046-3.231c.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92s.546-.453.92-.598c.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334"
                ></path>
              </svg>
            </span>
            <span class="card-face card-back">
              <span class="social-name social-name--full">Instagram</span>
              <span class="social-name social-name--short" aria-hidden="true">IG</span>
            </span>
          </span>
        </a>
        <a
          href="/portfolio/docs/Mauro_Gomez_CV.pdf"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Descargar CV"
          class="social-link"
        >
          <span class="card-inner">
            <span class="card-face card-front">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="currentColor"
                class="bi bi-file-earmark-richtext"
                viewBox="0 0 16 16"
              >
                <path
                  d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5z"
                ></path>
                <path
                  d="M4.5 12.5A.5.5 0 0 1 5 12h3a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5m0-2A.5.5 0 0 1 5 10h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5m1.639-3.708 1.33.886 1.854-1.855a.25.25 0 0 1 .289-.047l1.888.974V8.5a.5.5 0 0 1-.5.5H5a.5.5 0 0 1-.5-.5V8s1.54-1.274 1.639-1.208M6.25 6a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5"
                ></path>
              </svg>
            </span>
            <span class="card-face card-back">
              <span class="social-name social-name--full">CV</span>
              <span class="social-name social-name--short" aria-hidden="true">CV</span>
            </span>
          </span>
        </a>
      </li>
    </ul>
  </div>

  <div class="logo">
    <div class="lang-switch" role="group" aria-label="Idioma" data-i18n-aria="nav.lang">
      <button type="button" data-set-lang="es" class="is-on" aria-pressed="true">ES</button>
      <button type="button" data-set-lang="en" aria-pressed="false">EN</button>
    </div>
    <span>MAURO</span>
  </div>
</nav>

<script>
  const initNav = () => {
    const btn = document.getElementById("menu-toggle");
    const menu = document.getElementById("menu-items");
    btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
  };
  document.addEventListener("astro:page-load", initNav);
</script>

<style lang="scss" is:global>
  @import "../../assets/styles/scss/nav.scss";
</style>
