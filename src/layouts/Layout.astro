---
import Nav from '../components/shared/Nav.astro';
import { ClientRouter } from 'astro:transitions';
const { title = "Mi Portfolio" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <Nav />
    <main transition:animate="fade">
      <slot />
    </main>
    <script>
      import { initLanguage } from "../scripts/i18n";
      const bootLanguage = () => initLanguage();
      document.addEventListener("astro:page-load", bootLanguage);
      bootLanguage();
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html, body {
    width: 100%;
    background-color: #111111;
    color: white;
    overflow-x: hidden;
  }

  main {
    width: 100%;
    display: block;
  }
</style>