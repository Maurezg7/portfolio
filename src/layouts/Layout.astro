---
import Nav from '../components/shared/Nav.astro';
import { ClientRouter } from 'astro:transitions';
const { title = "Mi Portfolio" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <Nav />
    <main transition:animate="fade">
      <slot />
    </main>
  </body>
</html>