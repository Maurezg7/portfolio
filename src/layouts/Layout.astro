---
import Background3D from '../components/shared/Background3D.astro';
import Nav from '../components/shared/Nav.astro';
import { ClientRouter } from 'astro:transitions';
const { title = "Mi Portfolio" } = Astro.props;
const description = "Mauro Gomez, desarrollador full stack: backends en Java, Python y Rust e interfaces en Angular, Next.js, React y Astro. 2º puesto en el Hackathon PunaTech.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Mauro Gomez",
  jobTitle: "Full Stack Developer",
  description,
  url: "https://maurezg7.github.io/portfolio/",
  sameAs: ["https://github.com/Maurezg7"],
  knowsAbout: ["Java", "Spring Boot", "Python", "FastAPI", "Rust", "Angular", "Next.js", "React", "Astro", "Solidity", "Django", "Docker", "Kubernetes", "AWS", "PostgreSQL", "MongoDB", "HTML", "CSS", "JavaScript", "TypeScript", "Software Testing", "Swagger", "Postman", "Tailwind CSS", "C", "C++", "Algebra", "Mathematical Analysis", "Godot", "Unity", "GDScript", "C#"],
  alumniOf: "UPATECO",
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action https://formspree.io; base-uri 'self'; object-src 'none'; frame-src 'none'" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://maurezg7.github.io/portfolio/image/brand/nodus-og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
    <ClientRouter />
  </head>
  <body>
    <Background3D />
    <Nav />
    <main transition:animate="fade">
      <slot />
    </main>
    <script>
      import { initLanguage } from "../scripts/i18n";
      const bootLanguage = () => initLanguage();
      document.addEventListener("astro:page-load", bootLanguage);
      bootLanguage();

      // Scroll reveal
      const bindReveal = () => {
        const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
        if (!("IntersectionObserver" in window) || matchMedia("(prefers-reduced-motion: reduce)").matches) {
          els.forEach((e) => e.classList.add("is-in"));
          return;
        }
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) { const t = en.target as HTMLElement; t.classList.add("is-in"); io.unobserve(t); setTimeout(() => (t.style.transitionDelay = ""), 1000); }
          });
        }, { threshold: 0.12 });
        els.forEach((e, i) => { e.style.transitionDelay = `${(i % 4) * 70}ms`; io.observe(e); });
      };
      document.addEventListener("astro:page-load", bindReveal);
      bindReveal();

      // 3D tilt on framed photos
      const bindTilt = () => {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((el) => {
          if (el.dataset.tiltBound) return;
          el.dataset.tiltBound = "1";
          el.addEventListener("pointermove", (e) => {
            const r = el.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - 0.5;
            const y = (e.clientY - r.top) / r.height - 0.5;
            el.style.transform = `perspective(700px) rotateY(${x * 14}deg) rotateX(${-y * 14}deg) scale(1.03)`;
          });
          el.addEventListener("pointerleave", () => (el.style.transform = ""));
        });
      };
      document.addEventListener("astro:page-load", bindTilt);
      bindTilt();
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html, body {
    width: 100%;
    background-color: #0a0a0a;
    color: #ffffff;
    overflow-x: hidden;
  }

  :root {
    --neon-green: #7dff5a;
    --neon-orange: #ff9a3d;
    --white: #ffffff;
  }

  /* Smart TV / 4K: scale rem up */
  @media (min-width: 1920px) { html { font-size: 125%; } }
  @media (min-width: 2560px) { html { font-size: 175%; } }
  @media (min-width: 3840px) { html { font-size: 250%; } }
  /* Smartwatch / tiny screens */
  @media (max-width: 280px) { html { font-size: 70%; } }
  @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }

  ::selection { background: var(--neon-green); color: #0a0a0a; }
  :focus-visible { outline: 2px solid var(--neon-green); outline-offset: 3px; }
  html { scroll-behavior: smooth; scrollbar-color: var(--neon-orange) #0a0a0a; scrollbar-width: thin; }
  body { -webkit-font-smoothing: antialiased; }

  [data-reveal] { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); }
  [data-reveal].is-in { opacity: 1; transform: none; }
  img, svg, video { max-width: 100%; }
  body { padding-left: env(safe-area-inset-left); padding-right: env(safe-area-inset-right); }
  /* Round smartwatch screens: keep content off the edges */
  @media (max-width: 280px) { body { padding-inline: 0.35rem; } }
  /* Landscape phones: avoid 100vh traps */
  @media (max-height: 500px) and (orientation: landscape) { #container, #contact_container, #detail_container { min-height: auto; } }

  main {
    width: 100%;
    display: block;
  }
</style>