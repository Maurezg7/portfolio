        </div>
      </div>

      <div class="contact_deco">
        <span>01</span>
        <div class="deco_line"></div>
        <span data-i18n="contact.ready">DISPONIBLE PARA TRABAJAR</span>
      </div>
    </div>

    <div class="contact_form_wrapper">
      <form action="https://formspree.io/f/xeelygyy" method="POST">
        <div class="form_group">
          <label for="email" data-i18n="contact.email">TU_CORREO</label>
          <input id="email" type="email" name="email" placeholder="hola@ejemplo.com" data-i18n-placeholder="contact.emailPh" required />
        </div>
        <div class="form_group">
          <label for="message" data-i18n="contact.message">MENSAJE</label>
          <textarea id="message" name="message" placeholder="Contame tu idea..." data-i18n-placeholder="contact.messagePh" required></textarea>
        </div>
        <button type="submit">
          <span data-i18n="contact.send">ENVIAR MENSAJE</span>
          <svg viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708"/>
          </svg>
        </button>
      </form>
    </div>

  </div>
</Layout>

<style>
  /* El reset vive en Layout.astro con is:global. Repetirlo acá lo vuelve
     scopeado ([data-astro-cid-*], especificidad 0-1-0), lo que empata con
     cualquier selector de clase y le gana por orden de aparición: eso anulaba
     el padding de .social_btn, .contact_email y los overrides responsive. */
  html, body {
    background-color: #111111;
    color: white;
    overflow-x: hidden;
    margin: 0%;
    padding: 0%;
    box-sizing: border-box;
  }
</style>
