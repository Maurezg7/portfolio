---
import Layout from "../layouts/Layout.astro";
import "../assets/styles/scss/contact.scss";
---

<Layout title="Mauro Gomez - Contactame">
  <div id="contact_container">

    <div class="contact_info">
      <span class="contact_tag">CONTACTO_</span>
      <h1>HABLE<span class="accent">MOS</span></h1>

      <p class="contact_tagline">
        ¿Tenés un proyecto en mente o querés charlar sobre una oportunidad?
        Estoy disponible.
      </p>

      <div class="contact_links">
        <a href="mailto:mauroleonelg7@gmail.com" class="contact_email">
          <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1zm13 2.383-4.708 2.825L15 11.105zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741M1 11.105l4.708-2.897L1 5.383z"/>
          </svg>
          mauroleonelg7@gmail.com
        </a>

        <div class="contact_socials">
          <a href="https://www.linkedin.com/in/maurezg7/" target="_blank" rel="noopener noreferrer" class="social_btn">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            LinkedIn
          </a>
          <a href="https://github.com/Maurezg7" target="_blank" rel="noopener noreferrer" class="social_btn">
            <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"/>
            </svg>
            GitHub
          </a>
          <a href="https://x.com/Maurezg7" target="_blank" rel="noopener noreferrer" class="social_btn">
            <svg viewBox="0 0 50 50" xmlns="http://www.w3.org/2000/svg">
              <path d="M 11 4 C 7.134 4 4 7.134 4 11 L 4 39 C 4 42.866 7.134 46 11 46 L 39 46 C 42.866 46 46 42.866 46 39 L 46 11 C 46 7.134 42.866 4 39 4 L 11 4 z M 13.085938 13 L 21.023438 13 L 26.660156 21.009766 L 33.5 13 L 36 13 L 27.789062 22.613281 L 37.914062 37 L 29.978516 37 L 23.4375 27.707031 L 15.5 37 L 13 37 L 22.308594 26.103516 L 13.085938 13 z M 16.914062 15 L 31.021484 35 L 34.085938 35 L 19.978516 15 L 16.914062 15 z"/>
            </svg>
            X
          </a>
        </div>
      </div>

      <div class="contact_deco">
        <span>01</span>
        <div class="deco_line"></div>
        <span>DISPONIBLE PARA TRABAJAR</span>
      </div>
    </div>

    <div class="contact_form_wrapper">
      <form action="https://formspree.io/f/xeelygyy" method="POST">
        <div class="form_group">
          <label for="email">TU_CORREO</label>
          <input id="email" type="email" name="email" placeholder="hola@ejemplo.com" required />
        </div>
        <div class="form_group">
          <label for="message">MENSAJE</label>
          <textarea id="message" name="message" placeholder="Contame tu idea..." required></textarea>
        </div>
        <button type="submit">
          ENVIAR MENSAJE
          <svg viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708"/>
          </svg>
        </button>
      </form>
    </div>

  </div>
</Layout>

<style>
  /* El reset vive en Layout.astro con is:global. Repetirlo acá lo vuelve
     scopeado ([data-astro-cid-*], especificidad 0-1-0), lo que empata con
     cualquier selector de clase y le gana por orden de aparición: eso anulaba
     el padding de .social_btn, .contact_email y los overrides responsive. */
  html, body {
    background-color: rgb(26, 26, 26);
    color: white;
    overflow-x: hidden;
    margin: 0%;
    padding: 0%;
    box-sizing: border-box;
  }
</style>
