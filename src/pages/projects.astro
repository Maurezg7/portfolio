</Layout>

<style>
  *,
  ::after,
  ::before {
    margin: 0%;
    padding: 0%;
    box-sizing: border-box;
  }

  html,
  body {
    background-color: rgb(26, 26, 26);
    color: white;
    overflow-x: hidden;
    margin: 0%;
    padding: 0%;
    box-sizing: border-box;
  }
</style>
