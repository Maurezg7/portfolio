---
import Layout from "../layouts/Layout.astro";
import "../assets/styles/scss/projects.scss";
---

<Layout title="Mauro Gomez - Proyectos">
  <div id="container">
    <h1>WEB</h1>
    <h1>DEVELOPMENTS</h1>
    <div class="prin_proj">
      <h6>PROYECTOS</h6><div class="line"></div>
    </div>
    <ul class="project_container">
      <li class="item_project item_project--award">
        <div class="award_badge"><span>🏆 2DO PUESTO — HACKATHON PUNATECH</span></div>
        <div class="container_img">
          <img
            src="/portfolio/image/projects/SEM.webp"
            alt=""
          />
        </div>
        <div class="info_project">
          <h3>SEM SALTA</h3>
          <ul>
            <li>NestJs</li>
            <li>React</li>
            <li>Vite</li>
            <li>TaildWind</li>
            <li>MercadoPago</li>
            <li>PostgreSQL</li>
          </ul>
          <div class="section_url">
            <span>MAYO_2026</span>
            <div class="btn_group">
              <a href="/portfolio/projects/sem-salta" class="btn_details">
                VER DETALLES
                <svg viewBox="0 0 16 16">
                  <path
                    fill-rule="evenodd"
                    d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708"
