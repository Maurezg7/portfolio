---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Mauro Gomez - Proyectos">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
  </head>
  <div id="container" transition:persist>
    <h1>WEB</h1>
    <h1>DEVELOPMENTS</h1>
    <div class="prin_proj">
      <h6>PROYECTOS_DESTACADOS</h6><div class="line"></div>
    </div>
    <ul class="project_container">
      <li class="item_project">
        <div class="container_img">
          <img src="/portfolio/image/projects/hermes_presentation.webp" alt="" />
        </div>
        <div class="info_project">
          <h3>HERMES</h3>
          <ul>
            <li>Java</li>
            <li>SpringBoot</li>
            <li>Angular</li>
            <li>SASS - SCSS</li>
            <li>Typescript</li>
            <li>PostgreSQL</li>
          </ul>
          <div class="section_url">
            <span>MARZO_2026</span>
            <a href="https://hermes-inky-two.vercel.app/">
              SITIO WEB
              <svg
                class="../../public/image/icons/chevron-right.svg"
                viewBox="0 0 16 16"
              >
                <path
                  fill-rule="evenodd"
                  d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </li>
      <li class="item_project">
        <div class="container_img">
          <img src="/portfolio/image/projects/Portfolio_Web.webp" alt="" />
        </div>
        <div class="info_project">
          <h3>PORTFOLIO WEB</h3>
          <ul>
            <li>AstroJS</li>
            <li>JavaScript</li>
            <li>SASS - SCSS</li>
            <li>CSS3</li>
            <li>HTML5</li>
          </ul>
          <div class="section_url">
            <span>MAYO_2026</span>
            <a href="https://maurezg7.github.io/portfolio/">
              SITIO WEB
              <svg
                class="/portfolio/image/icons/chevron-right.svg"
                viewBox="0 0 16 16"
              >
                <path
                  fill-rule="evenodd"
                  d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </li>
    </ul>
  </div>
</Layout>

<style>
  @import url(../assets/styles/css/projects.css);
  *,
  ::after,
  ::before {
    margin: 0%;
    padding: 0%;
    box-sizing: border-box;
  }

  html,
  body {
    background-color: rgb(26, 26, 26);
    color: white;
    overflow-x: hidden;
    margin: 0%;
    padding: 0%;
    box-sizing: border-box;
  }
</style>
