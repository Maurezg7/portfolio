                  ></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </li>
      <li class="item_project">
        <div class="container_img">
          <img src="/portfolio/image/projects/AgroCentinela.webp" alt="" />
        </div>
        <div class="info_project">
