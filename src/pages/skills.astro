---
import Layout from "../layouts/Layout.astro";
import "../assets/styles/scss/skills.scss";

const groups = [
  {
    title: "LENGUAJES",
    skills: [
      { name: "C", icon: "/portfolio/image/languages/c.svg" },
      { name: "C++", icon: "/portfolio/image/languages/cpp.svg" },
      { name: "Java", icon: "/portfolio/image/languages/java.webp" },
      { name: "Python", icon: "/portfolio/image/languages/python-svgrepo-com.svg" },
      { name: "TypeScript", icon: "/portfolio/image/languages/typescript.webp" },
      { name: "Rust", icon: "/portfolio/image/languages/rust.svg" },
    ],
  },
  {
    title: "BACKEND",
    skills: [
      { name: "Spring Boot", icon: "/portfolio/image/languages/springboot.webp" },
      { name: "NestJS", icon: "/portfolio/image/languages/icons8-nestjs.svg" },
      { name: "FastAPI", icon: "/portfolio/image/languages/FastAPI.svg" },
    ],
  },
  {
    title: "FRONTEND",
    skills: [
      { name: "Angular", icon: "/portfolio/image/languages/angular.webp" },
      { name: "Next.js", icon: "/portfolio/image/languages/nextjs.svg" },
      { name: "Svelte", icon: "/portfolio/image/languages/svelte.svg" },
      { name: "Astro", icon: "/portfolio/image/languages/astro.svg" },
    ],
  },
  {
    title: "DATOS",
    skills: [
      { name: "PostgreSQL", icon: "/portfolio/image/languages/postgresql.webp" },
    ],
  },
];
---

<Layout title="Mauro Gomez - Habilidades">
  <div id="container">
    <div id="img_container">
      <img src="/portfolio/image/perfil/Skills_Photo.webp" alt="Mauro Gomez" />
    </div>
    <div id="sections_container">
      <header class="skills_head">
        <span class="skills_label" data-i18n="skills.label">HABILIDADES_</span>
        <h1>STACK</h1>
        <div class="line"></div>
      </header>

      <div class="groups">
        {
          groups.map((group, index) => (
            <section class="group">
              <div class="group_title">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h2 data-i18n={["skills.languages", "skills.backend", "skills.frontend", "skills.data"][index]}>
                  {group.title}
                </h2>
              </div>
              <ul class="skill_grid">
                {group.skills.map((skill) => (
                  <li class="skill_card">
                    <div class="cont_icon">
                      <img src={skill.icon} alt="" />
                    </div>
                    <span class="skill_name">{skill.name}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </div>
</Layout>
