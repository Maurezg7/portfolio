---
import Layout from "../layouts/Layout.astro";
import "../assets/styles/scss/skills.scss";

const lang = "/portfolio/image/languages/";
const learning = (name: string, file: string) => ({ name, icon: lang + file, status: "learning" });

const groups = [
  {
    title: "BACKEND · JAVA",
    key: "skills.backend",
    skills: [
      { name: "Java", icon: lang + "java.webp" },
      { name: "Spring Boot", icon: lang + "springboot.webp" },
      { name: "Spring Security", icon: lang + "springsecurity.svg" },
      { name: "Spring Data JPA", icon: lang + "hibernate.svg" },
      { name: "PostgreSQL", icon: lang + "postgresql.webp" },
      { name: "Docker", icon: lang + "docker.svg" },
      { name: "Git", icon: lang + "git.svg" },
    ],
  },
  {
    title: "JAVA · APRENDIENDO",
    key: "skills.javalearning",
    skills: [
      learning("JUnit", "junit5.svg"),
      learning("Mockito", "mockito.webp"),
      learning("Kafka", "apachekafka.svg"),
      learning("Spring Cloud", "springcloud.svg"),
      learning("Kubernetes", "kubernetes.svg"),
      learning("AWS", "aws.svg"),
      learning("GitHub Actions", "githubactions.svg"),
    ],
  },
  {
    title: "FRONTEND",
    key: "skills.frontend",
    skills: [{ name: "React", icon: lang + "react.webp" }, learning("Next.js", "nextjs.svg")],
  },
  {
    title: "RUST · APRENDIENDO",
    key: "skills.learning",
    skills: [
      learning("Rust", "rust.svg"),
      learning("Tokio", "tokio.svg"),
      learning("Axum", "axum.svg"),
      learning("Actix Web", "actix.svg"),
      learning("SQLx", "sqlx.svg"),
      learning("Serde", "serde.webp"),
      learning("Odra", "odra.webp"),
    ],
  },
  {
    title: "MATEMÁTICA",
    key: "skills.math",
    skills: [
      { name: "Álgebra", icon: lang + "algebra.svg", key: "skills.name.algebra" },
      { name: "Análisis Matemático", icon: lang + "calculus.svg", key: "skills.name.calculus" },
    ],
  },
  {
    title: "IDIOMAS",
    key: "skills.languages",
    skills: [
      { name: "Español", icon: lang + "lang-es.svg", key: "skills.name.spanish", level: "native" },
      { name: "Inglés", icon: lang + "lang-en.svg", key: "skills.name.english", level: "b1" },
    ],
  },
  {
    title: "VIDEOJUEGOS",
    key: "skills.games",
    skills: [
      { name: "Unity", icon: lang + "unity.svg" },
      { name: "Godot", icon: lang + "godotengine.svg" },
    ],
  },
] as { title: string; key: string; skills: { name: string; icon: string; status?: string; key?: string; level?: string }[] }[];
const total = groups.reduce((n, g) => n + g.skills.length, 0);
---

<Layout title="Mauro Gomez - Habilidades">
  <div id="container">
    <div id="sections_container">
      <header class="skills_head">
        <span class="skills_label" data-i18n="skills.label">HABILIDADES_</span>
        <h1>STACK</h1>
        <div class="line"></div>
        <div class="skills_stats">
          <span><b>{total}</b> <i data-i18n="skills.stat.tech">tecnologías</i></span>
          <span><b>{groups.length}</b> <i data-i18n="skills.stat.areas">áreas</i></span>
        </div>
      </header>

      <div class="filters" role="tablist">
        <button type="button" class="chip is-on" data-filter="all" data-i18n="skills.all">TODO</button>
        {groups.map((g) => <button type="button" class="chip" data-filter={g.key} data-i18n={g.key}>{g.title}</button>)}
      </div>

      <div class="groups">
        {
          groups.map((group, index) => (
            <section class="group" data-group={group.key}>
              <div class="group_title">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h2 data-i18n={group.key}>
                  {group.title}
                </h2>
              </div>
              <ul class="skill_grid">
                {group.skills.map((skill) => (
                  <li class="skill_card" data-tilt>
                    <div class="cont_icon">
                      <img src={skill.icon} alt="" width="40" height="40" loading="lazy" decoding="async" />
                    </div>
                    <span class="skill_name" data-i18n={skill.key}>{skill.name}</span>
                    {skill.status && <em class={`tag tag--${skill.status}`} data-i18n={`skills.tag.${skill.status}`}>APRENDIENDO</em>}
                    {skill.level && <em class="tag tag--level" data-i18n={`skills.level.${skill.level}`}>{skill.level === "native" ? "NATIVO" : "B1"}</em>}
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </div>
</Layout>

<script>
  const bindFilters = () => {
    const chips = document.querySelectorAll<HTMLButtonElement>(".chip");
    const groups = document.querySelectorAll<HTMLElement>(".group");
    chips.forEach((chip) => {
      if (chip.dataset.bound) return;
      chip.dataset.bound = "1";
      chip.addEventListener("click", () => {
        chips.forEach((c) => c.classList.toggle("is-on", c === chip));
        const f = chip.dataset.filter;
        groups.forEach((g) => (g.hidden = f !== "all" && g.dataset.group !== f));
      });
    });
  };
  document.addEventListener("astro:page-load", bindFilters);
  bindFilters();
</script>
