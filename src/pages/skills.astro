---

<Layout title="Mauro Gomez - Habilidades">
  <div id="container">
    <div id="img_container">
      <img src="/portfolio/image/perfil/Skills_Photo.webp" alt="" />
    </div>
    <div id="sections_container">
      <span class="skills_label">HABILIDADES_</span>
      <ul id="sections">
        {items.map((item, index) => (
          <li data-index={index}>
            <span>{String(index + 1).padStart(2, "0")}</span><h1>{item.title}</h1>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ items }}>
  const setupSkillsInteractivity = () => {
    const sections = document.getElementById("sections");
    const container_sections = document.getElementById("sections_container");

    let sectionTools = document.getElementById("section-tools");
    if (!sectionTools) {
      sectionTools = document.createElement("div");
      sectionTools.id = "section-tools";
    }

    const buttons = document.querySelectorAll("li[data-index]");

    buttons.forEach((button) => {
      button.onclick = () => {
        const index = button.getAttribute("data-index");
        const info = items[index];
        const withIcon = info.skills.filter((skill) => skill.icon);
        const withoutIcon = info.skills.filter((skill) => !skill.icon);

        sections.style.display = "none";
        document.querySelector(".skills_label").style.display = "none";

        sectionTools.innerHTML = `
          <button id="back-btn">
            <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"/>
            </svg>
            HABILIDADES
          </button>
          <div class="detail_header">
            <span class="skills_tag">CATEGORÍA_</span>
            <h1>${info.title}</h1>
            <div class="line"></div>
          </div>
          ${withIcon.length ? `
            <ul class="section_tools">
              ${withIcon.map((skill) => `
                <li class="icon-item">
                  <div class="cont_icon">
                    <img src="${skill.icon}" alt="" class="icon-img">
                  </div>
                  <span class="icon-name">${skill.name}</span>
                </li>`).join("")}
            </ul>` : ""}
          ${withoutIcon.length ? `
            <ul class="section_chips">
              ${withoutIcon.map((skill) => `
                <li class="skill-chip">${skill.name}</li>`).join("")}
            </ul>` : ""}
        `;

        container_sections.appendChild(sectionTools);

        document.getElementById("back-btn").onclick = () => {
          sectionTools.remove();
          sections.style.display = "flex";
          document.querySelector(".skills_label").style.display = "block";
        };
      };
    });
  };

  document.addEventListener("astro:page-load", setupSkillsInteractivity);
</script>

<style>
  *,
  ::after,
  ::before {
    margin: 0%;
    padding: 0%;
    box-sizing: border-box;
  }

  html,
  body {
    background-color: rgb(26, 26, 26);
    color: white;
    overflow-x: hidden;
    margin: 0%;
    padding: 0%;
    box-sizing: border-box;
  }
</style>
