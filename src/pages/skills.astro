const total = groups.reduce((n, g) => n + g.skills.length, 0);
---

<Layout title="Mauro Gomez - Habilidades">
  <div id="container">
    <div id="sections_container">
      <header class="skills_head">
        <span class="skills_label" data-i18n="skills.label">HABILIDADES_</span>
        <h1>STACK</h1>
        <div class="line"></div>
        <div class="skills_stats">
          <span><b>{total}</b> <i data-i18n="skills.stat.tech">tecnologías</i></span>
          <span><b>{groups.length}</b> <i data-i18n="skills.stat.areas">áreas</i></span>
        </div>
      </header>

      <div class="filters" role="tablist">
        <button type="button" class="chip is-on" data-filter="all" data-i18n="skills.all">TODO</button>
        {groups.map((g) => <button type="button" class="chip" data-filter={g.key} data-i18n={g.key}>{g.title}</button>)}
      </div>

      <div class="groups">
        {
          groups.map((group, index) => (
            <section class="group" data-group={group.key}>
              <div class="group_title">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h2 data-i18n={group.key}>
                  {group.title}
                </h2>
              </div>
              <ul class="skill_grid">
                {group.skills.map((skill) => (
                  <li class="skill_card" data-tilt>
                    <div class="cont_icon">
                      <img src={skill.icon} alt="" />
                    </div>
                    <span class="skill_name">{skill.name}</span>
                    {skill.status && <em class={`tag tag--${skill.status}`} data-i18n={`skills.tag.${skill.status}`}>{skill.status === "learning" ? "APRENDIENDO" : "PRÓXIMO"}</em>}
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </div>
</Layout>

<script>
  const bindFilters = () => {
    const chips = document.querySelectorAll<HTMLButtonElement>(".chip");
    const groups = document.querySelectorAll<HTMLElement>(".group");
    chips.forEach((chip) => {
      if (chip.dataset.bound) return;
      chip.dataset.bound = "1";
      chip.addEventListener("click", () => {
        chips.forEach((c) => c.classList.toggle("is-on", c === chip));
        const f = chip.dataset.filter;
        groups.forEach((g) => (g.hidden = f !== "all" && g.dataset.group !== f));
      });
    });
  };
  document.addEventListener("astro:page-load", bindFilters);
  bindFilters();
</script>
