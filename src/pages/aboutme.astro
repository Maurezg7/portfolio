---
import Layout from "../layouts/Layout.astro";
import "../assets/styles/scss/aboutme.scss";

const msgItems = [
  {
    titleKey: "about.me.title",
    textKey: "about.me.text",
    msgh4:
      "Soy Mauro, desarrollador de software. Estudio en la Universidad Provincial de Administración, Tecnología y Oficios (UPATECO) y busco proyectos donde pueda construir de verdad.",
    msgh5:
      "Trabajo el producto de punta a punta: APIs con Java, Spring Boot, NestJS y FastAPI, interfaces con Angular, Next.js, Svelte y Astro, y PostgreSQL para los datos.",
  },
  {
    titleKey: "about.back.title",
    textKey: "about.back.text",
    msgh4: "Java, Spring Boot, NestJS y FastAPI",
    msgh5:
      "Diseño APIs REST con autenticación JWT, validación y manejo de errores. Aplico DTO y SOLID para que el servicio se pueda mantener y extender.",
  },
  {
    titleKey: "about.front.title",
    textKey: "about.front.text",
    msgh4: "Angular, Next.js, Svelte y Astro",
    msgh5:
      "Armo interfaces que se leen bien en el escritorio y en el celular, conectadas a APIs REST y con el estado de la pantalla bajo control.",
  },
  {
    titleKey: "about.data.title",
    textKey: "about.data.text",
    msgh4: "PostgreSQL",
    msgh5:
      "Modelo la base, escribo consultas con joins y subconsultas, y la conecto desde Spring Boot, NestJS y FastAPI.",
  },
];
---

<Layout title="Mauro Gomez - Sobre Mi">
  <div id="aboutme_container">
    <div class="container container_img">
      <img src="/portfolio/image/perfil/Perfil_Photo.webp" alt="" />
    </div>
    <div class="container container_text">
      <span class="aboutme_label" data-i18n="about.kicker">SOBRE_MÍ</span>
      <div class="title_mask">
        <h1 data-i18n="about.title">DESARROLLADOR FULL STACK</h1>
      </div>
      <div class="title_line"></div>
      <ul>
        <li data-index="0" class="is-active">
          <div class="icon-box">
            <svg viewBox="0 0 16 16">
              <path
                d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"
              ></path>
            </svg>
          </div>
          <span data-i18n="about.tab.me">Conóceme</span>
        </li>
        <li data-index="1">
          <div class="icon-box">
            <svg viewBox="0 0 16 16">
              <path
                d="M0 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2h2a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1z"
              ></path>
            </svg>
          </div>
          <span data-i18n="about.tab.back">Backend</span>
        </li>
        <li data-index="2">
          <div class="icon-box">
            <svg viewBox="0 0 16 16">
              <path
                d="M0 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2h2a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2H2a2 2 0 0 1-2-2zm5 10v2a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1h-2v5a2 2 0 0 1-2 2z"
              ></path>
            </svg>
          </div>
          <span data-i18n="about.tab.front">Frontend</span>
        </li>
        <li data-index="3">
          <div class="icon-box">
            <svg viewBox="0 0 16 16">
              <path
                d="M4.318 2.687C5.234 2.271 6.536 2 8 2s2.766.27 3.682.687C12.644 3.125 13 3.627 13 4c0 .374-.356.875-1.318 1.313C10.766 5.729 9.464 6 8 6s-2.766-.27-3.682-.687C3.356 4.875 3 4.373 3 4c0-.374.356-.875 1.318-1.313M13 5.698V7c0 .374-.356.875-1.318 1.313C10.766 8.729 9.464 9 8 9s-2.766-.27-3.682-.687C3.356 7.875 3 7.373 3 7V5.698c.271.202.58.378.904.525C4.978 6.711 6.427 7 8 7s3.022-.289 4.096-.777A5 5 0 0 0 13 5.698M14 4c0-1.007-.875-1.755-1.904-2.223C11.022 1.289 9.573 1 8 1s-3.022.289-4.096.777C2.875 2.245 2 2.993 2 4v9c0 1.007.875 1.755 1.904 2.223C4.978 15.71 6.427 16 8 16s3.022-.289 4.096-.777C13.125 14.755 14 14.007 14 13zm-1 4.698V10c0 .374-.356.875-1.318 1.313C10.766 11.729 9.464 12 8 12s-2.766-.27-3.682-.687C3.356 10.875 3 10.373 3 10V8.698c.271.202.58.378.904.525C4.978 9.71 6.427 10 8 10s3.022-.289 4.096-.777A5 5 0 0 0 13 8.698m0 3V13c0 .374-.356.875-1.318 1.313C10.766 14.729 9.464 15 8 15s-2.766-.27-3.682-.687C3.356 13.875 3 13.373 3 13v-1.302c.271.202.58.378.904.525C4.978 12.71 6.427 13 8 13s3.022-.289 4.096-.777c.324-.147.633-.323.904-.525"
              ></path>
            </svg>
          </div>
          <span data-i18n="about.tab.data">Database</span>
        </li>
      </ul>

      <div class="text_block">
        <h4 id="text-h4" data-i18n="about.me.title">
          Soy Mauro, desarrollador de software. Estudio en la Universidad
          Provincial de Administración, Tecnología y Oficios (UPATECO) y busco
          proyectos donde pueda construir de verdad.
        </h4>
        <h5 id="text-h5" data-i18n="about.me.text">
          Trabajo el producto de punta a punta: APIs con Java, Spring Boot,
          NestJS y FastAPI, interfaces con Angular, Next.js, Svelte y Astro, y
          PostgreSQL para los datos.
        </h5>
      </div>

      <button id="skills" data-i18n="about.cta">HABILIDADES</button>
    </div>
  </div>
</Layout>

<script define:vars={{ msgItems }}>
  const writeAbout = (el, key, fallback) => {
    el.dataset.i18n = key;
    const lang = window.__portfolioLang ? window.__portfolioLang() : "es";
    const translated = lang === "en" && window.__portfolioT ? window.__portfolioT(key) : "";
    el.textContent = translated || fallback;
  };

  const setupSkillsInteractivity = () => {
    const buttons = document.querySelectorAll("li[data-index]");
    const titleDisplay = document.getElementById("text-h4");
    const descDisplay = document.getElementById("text-h5");

    if (!buttons.length || !titleDisplay || !descDisplay) return;

    buttons.forEach((button) => {
      if (button.dataset.bound) return;
      button.dataset.bound = "1";
      button.addEventListener("click", () => {
        const index = button.getAttribute("data-index");
        const info = msgItems[index];

        if (info) {
          buttons.forEach((item) => item.classList.remove("is-active"));
          button.classList.add("is-active");
          writeAbout(titleDisplay, info.titleKey, info.msgh4);
          writeAbout(descDisplay, info.textKey, info.msgh5);
          const block = titleDisplay.closest(".text_block");
          block?.classList.remove("is-swapping");
          void block?.offsetWidth;
          block?.classList.add("is-swapping");
        }
      });
    });
  };

  const changePage = () => {
    const buttonAbout = document.getElementById("skills");
    buttonAbout?.addEventListener("click", (e) => {
      e.preventDefault();
      window.location.href = "/portfolio/skills";
    });
  };

  setupSkillsInteractivity();
  document.addEventListener("astro:page-load", setupSkillsInteractivity);
  document.addEventListener("astro:page-load", changePage);
</script>

<style>
  *,
  ::after,
  ::before {
    margin: 0%;
    padding: 0%;
    box-sizing: border-box;
  }
  html,
  body {
    background-color: #111111;
    color: white;
    overflow-x: hidden;
    margin: 0%;
    padding: 0%;
    box-sizing: border-box;
  }
</style>
