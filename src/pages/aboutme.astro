---
import Layout from "../layouts/Layout.astro";
import "../assets/styles/scss/aboutme.scss";

const msgItems = [
  {
    titleKey: "about.me.title",
    textKey: "about.me.text",
    msgh4:
      "Soy Mauro, desarrollador full stack y estudiante en UPATECO. Convierto ideas en productos que funcionan en producción y busco un equipo donde aportar desde el primer día.",
    msgh5:
      "Trabajo el producto de punta a punta: 2º puesto en el Hackathon PunaTech y varios proyectos desplegados: backends con Java, Python y Rust, e interfaces con Angular, Next.js, React y Astro.",
  },
  {
    titleKey: "about.back.title",
    textKey: "about.back.text",
    msgh4: "Java, Python y Rust",
    msgh5:
      "Diseño APIs REST seguras con JWT, validación y manejo claro de errores, en Java con Spring Boot y en Python con FastAPI, más contratos inteligentes en Rust. DTO y SOLID para que el código sea fácil de mantener.",
  },
  {
    titleKey: "about.front.title",
    textKey: "about.front.text",
    msgh4: "Angular, Next.js, React y Astro",
    msgh5:
      "Interfaces rápidas y accesibles que se adaptan desde un smartwatch hasta una TV, conectadas a APIs REST y con estado predecible.",
  },
];
---

<Layout title="Mauro Gomez - Sobre Mi">
  <div id="aboutme_container">
    <div class="container container_img">
      <img src="/portfolio/image/perfil/Perfil_Photo.webp" alt="Mauro Gomez, full stack developer" data-tilt />
    </div>
    <div class="container container_text">
      <span class="aboutme_label" data-i18n="about.kicker">SOBRE_MÍ</span>
      <div class="title_mask">
        <h1 data-i18n="about.title">DESARROLLADOR FULL STACK</h1>
      </div>
      <div class="title_line"></div>
      <ul>
        <li data-index="0" class="is-active">
          <div class="icon-box">
            <svg viewBox="0 0 16 16">
              <path
                d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"
              ></path>
            </svg>
          </div>
          <span data-i18n="about.tab.me">Conóceme</span>
        </li>
        <li data-index="1">
          <div class="icon-box">
            <svg viewBox="0 0 16 16">
              <path
                d="M0 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2h2a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1z"
              ></path>
            </svg>
          </div>
          <span data-i18n="about.tab.back">Backend</span>
        </li>
        <li data-index="2">
          <div class="icon-box">
            <svg viewBox="0 0 16 16">
              <path
                d="M0 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2h2a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2H2a2 2 0 0 1-2-2zm5 10v2a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1h-2v5a2 2 0 0 1-2 2z"
              ></path>
            </svg>
          </div>
          <span data-i18n="about.tab.front">Frontend</span>
        </li>
      </ul>

      <div class="text_block">
        <h4 id="text-h4" data-i18n="about.me.title">
          Soy Mauro, desarrollador full stack y estudiante en UPATECO. Convierto ideas en productos que funcionan en producción y busco un equipo donde aportar desde el primer día.
        </h4>
        <h5 id="text-h5" data-i18n="about.me.text">
          Trabajo el producto de punta a punta: APIs con Java, Spring Boot,
          NestJS y FastAPI, interfaces con Angular, Next.js, React y Astro, y
          PostgreSQL para los datos.
        </h5>
      </div>

      <button id="skills" data-i18n="about.cta">HABILIDADES</button>
    </div>
  </div>
</Layout>

<script define:vars={{ msgItems }}>
  const writeAbout = (el, key, fallback) => {
    el.dataset.i18n = key;
    const lang = window.__portfolioLang ? window.__portfolioLang() : "es";
    const translated = lang === "en" && window.__portfolioT ? window.__portfolioT(key) : "";
    el.textContent = translated || fallback;
  };

  const setupSkillsInteractivity = () => {
    const buttons = document.querySelectorAll("li[data-index]");
    const titleDisplay = document.getElementById("text-h4");
    const descDisplay = document.getElementById("text-h5");

    if (!buttons.length || !titleDisplay || !descDisplay) return;

    buttons.forEach((button) => {
      if (button.dataset.bound) return;
      button.dataset.bound = "1";
      button.addEventListener("click", () => {
        const index = button.getAttribute("data-index");
        const info = msgItems[index];

        if (info) {
          buttons.forEach((item) => item.classList.remove("is-active"));
          button.classList.add("is-active");
          writeAbout(titleDisplay, info.titleKey, info.msgh4);
          writeAbout(descDisplay, info.textKey, info.msgh5);
          const block = titleDisplay.closest(".text_block");
          block?.classList.remove("is-swapping");
          void block?.offsetWidth;
          block?.classList.add("is-swapping");
        }
      });
    });
  };

  const changePage = () => {
    const buttonAbout = document.getElementById("skills");
    buttonAbout?.addEventListener("click", (e) => {
      e.preventDefault();
      window.location.href = "/portfolio/skills";
    });
  };

  setupSkillsInteractivity();
  document.addEventListener("astro:page-load", setupSkillsInteractivity);
  document.addEventListener("astro:page-load", changePage);
</script>

<style>
  *,
  ::after,
  ::before {
    margin: 0%;
    padding: 0%;
    box-sizing: border-box;
  }
  html,
  body {
    background-color: #0a0a0a;
    color: white;
    overflow-x: hidden;
    margin: 0%;
    padding: 0%;
    box-sizing: border-box;
  }
</style>
