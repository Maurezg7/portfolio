---
import Layout from "../layouts/Layout.astro";
import ProjectImage from "../components/ProjectImage.astro";
import "../assets/styles/scss/welcome.scss";

const featured = [
  { id: "meetflow", name: "MeetFlow", file: "MeetFlow", tag: "Experiencia laboral", label: "home.feat.meet.tag", key: "meet", text: "App de videollamadas con sala de espera y anfitriones, hecha en equipo ágil en No Country." },
  { id: "achique", name: "Achique", file: "Achique", tag: "Argentina Space", key: "ach", text: "Bloqueo de streams piratas en vivo: cada orden la aprueba y firma un juez de turno. 1.er puesto en el Desafío Fútbol." },
  { id: "sem-salta", name: "SEM Salta", file: "SEM", tag: "PunaTech", key: "sem", text: "Pagos de estacionamiento medido con MercadoPago y panel de administración. Hecho para la Municipalidad de Salta." },
  { id: "cazatalentos", name: "Cazatalentos", file: "Cazatalentos", tag: "Monad", key: "caz", text: "Registro on-chain de quién creyó primero en un artista, con un contrato inmutable en Solidity." },
  { id: "dengue-centinela", name: "Dengue Centinela", file: "DengueCentinela", tag: "Salud pública", label: "home.feat.den.tag", key: "den", text: "Mapa de calor de riesgo de dengue en Salta, a partir de reportes por WhatsApp y clasificación con IA." },
];
---
<Layout title="Mauro Gomez - Full Stack">
  <div class="portfolio-home">
    <section class="intro" aria-labelledby="intro-name">
      <div class="intro-copy">
        <p class="eyebrow"><i></i><span data-i18n="home.status">Disponible para nuevos proyectos</span></p>
        <h1 id="intro-name">Mauro<br />Gomez<span>.</span></h1>
        <h2 data-i18n="home.role">Desarrollador full stack</h2>
        <p class="summary" data-i18n="home.line">Desarrollo APIs en Java con Spring Boot e interfaces en React. También programo en C y estoy aprendiendo Rust.</p>
        <div class="intro-links">
          <a class="primary" href="/portfolio/projects/"><span data-i18n="home.cta2">Ver proyectos</span><b aria-hidden="true">↗</b></a>
          <a href="/portfolio/aboutme/" data-i18n="home.cta">Sobre mí</a>
        </div>
      </div>
      <figure class="sentinel">
        <div class="sentinel-art">
          <img src="/portfolio/image/brand/nodus-focus.webp" srcset="/portfolio/image/brand/nodus-focus-sm.webp 400w, /portfolio/image/brand/nodus-focus.webp 564w" sizes="(max-width: 700px) 92vw, (max-width: 1200px) 44vw, 530px" width="564" height="496" fetchpriority="high" decoding="async" alt="NODUS" />
          <span class="figure-id" aria-hidden="true">FIG. 01 / MG</span>
        </div>
        <figcaption><strong>NODUS</strong><span data-i18n="home.nodus">El centinela que conecta backend, frontend y datos.</span></figcaption>
      </figure>
    </section>

    <div class="stack-strip">
      <a class="eyebrow" href="/portfolio/skills/">Stack <span aria-hidden="true">↗</span></a>
      <ul>
        {["Java", "Spring Boot", "React", "C", "Rust"].map((name) => <li>
          <img src={`/portfolio/image/languages/${name.toLowerCase().replace(" ", "")}.svg`} width="22" height="22" alt="" />
          {name}{name === "Rust" && <small data-i18n="home.learning">aprendiendo</small>}
        </li>)}
      </ul>
    </div>

    <section class="selected" aria-labelledby="featured-title">
      <header>
        <div><p class="eyebrow">Portfolio / 01</p><h2 id="featured-title" data-i18n="home.feat.title">Proyectos destacados</h2></div>
        <a class="award" href="/portfolio/projects/achique/"><span data-i18n="home.award">1.er puesto · Hackathon Argentina Space</span> ↗</a>
      </header>
      <div class="featured-grid">
        {featured.map((project, index) => <a class="featured-card" href={`/portfolio/projects/${project.id}/`}>
          <div class="project-cover">
            <ProjectImage file={project.file} sizes={index < 2 ? "(max-width: 700px) 92vw, (max-width: 1200px) 46vw, 566px" : "(max-width: 700px) 92vw, (max-width: 1200px) 30vw, 372px"} />
          </div>
          <div class="project-copy">
            <div class="project-meta"><span data-i18n={project.label}>{project.tag}</span><span aria-hidden="true">/ 0{index + 1}</span></div>
            <h3>{project.name}<span aria-hidden="true">↗</span></h3>
            <p data-i18n={`home.feat.${project.key}`}>{project.text}</p>
          </div>
        </a>)}
      </div>
      <a class="all-projects" href="/portfolio/projects/" data-i18n="home.feat.all">Ver todos los proyectos</a>
    </section>
    <section class="contact-band">
      <h2 data-i18n="home.cta.title">Construyamos algo juntos</h2>
      <a class="primary" href="/portfolio/contact/"><span data-i18n="home.cta.btn">Contactame</span> ↗</a>
    </section>
  </div>
</Layout>
