---
import Layout from "../layouts/Layout.astro";
import "../assets/styles/scss/welcome.scss";
---

<Layout title="Mauro Gomez - Full Stack">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script type="importmap">
      {
        "imports": {
          "three": "https://cdn.jsdelivr.net/npm/three@<version>/build/three.module.js",
          "three/addons/": "https://cdn.jsdelivr.net/npm/three@<version>/examples/jsm/"
        }
      }
    </script>
  </head>
  <div id="container">
    <h1>SOY MAURO GOMEZ</h1>
    <h2 data-i18n="home.role">FULL STACK DEVELOPER</h2>
    <h3>JAVA ❖ NESTJS ❖ ANGULAR ❖ POSTGRESQL</h3>
    <p data-i18n="home.line">
      Armo el producto completo: la API, la interfaz y los datos. Código claro,
      pensado para crecer.
    </p>
      <button id="aboutme" data-i18n="home.cta">Sobre mí</button>
  </div>
</Layout>

<style>
  *,
  ::after,
  ::before {
    margin: 0%;
    padding: 0%;
    box-sizing: border-box;
  }
  html,
  body {
    background-color: #111111;
    color: white;
    overflow-x: hidden;
    margin: 0%;
    padding: 0%;
    box-sizing: border-box;
  }
</style>

<script>
  const changePage = () => {
    const buttonAbout = document.getElementById("aboutme");
    buttonAbout?.addEventListener("click", (e) => {
      e.preventDefault();
      window.location.href = "/portfolio/aboutme";
    });
  };

  document.addEventListener("astro:page-load", changePage);
</script>

